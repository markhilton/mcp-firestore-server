{
  "name": "@nerd305/mcp-firestore-server",
  "version": "3.3.0",
  "description": "MCP server for Firebase Firestore operations",
  "main": "index.js",
  "type": "module",
  "bin": {
    "mcp-firestore-server": "index.js"
  },
  "files": [
    "index.js",
    "src/"
  ],
  "scripts": {
    "start": "node index.js",
    "test": "node --test",
    "test:watch": "node --test --watch",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "validate:schemas": "node scripts/check-tool-schemas.mjs",
    "prepublishOnly": "npm run lint && npm test && npm run validate:schemas"
  },
  "keywords": [
    "mcp",
    "firestore",
    "firebase",
    "model-context-protocol"
  ],
  "author": "Mark Hilton",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "firebase-admin": "^14.5.1"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/markhilton/mcp-firestore-server.git"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "ajv": "^8.20.0",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1"
  }
}
